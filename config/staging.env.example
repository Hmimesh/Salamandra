# Private staging configuration template.
# Supply values through the deployment platform or secret manager. Do not commit
# a completed copy of this file.

# Runtime mode. This value is fixed for private staging.
SALAMANDRA_ENV=staging

# PostgreSQL SQLAlchemy URL. Store the completed value as a secret.
SALAMANDRA_DATABASE_URL=postgresql+psycopg://<staging-user>:<secret>@<staging-db-host>:5432/<staging-db-name>?sslmode=require

# Canonical public HTTPS origin, including scheme and no path.
SALAMANDRA_APP_ORIGIN=https://salamandra-staging.hmimesh.com

# Comma-separated exact HTTPS origins allowed to make credentialed requests.
SALAMANDRA_ALLOWED_ORIGINS=https://salamandra-staging.hmimesh.com

# Comma-separated hostnames accepted in the HTTP Host header.
SALAMANDRA_TRUSTED_HOSTS=salamandra-staging.hmimesh.com

# Require Secure authentication cookies in staging and production.
SALAMANDRA_COOKIE_SECURE=true

# Session lifetime in seconds, between 300 and 604800.
SALAMANDRA_SESSION_MAX_AGE_SECONDS=43200

# Structured application log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
SALAMANDRA_LOG_LEVEL=INFO

# Temporary controlled-onboarding window. Change to invite_only or disabled
# after staging test workspaces have been created.
SALAMANDRA_REGISTRATION_MODE=open

# Safe default until the hosting provider's direct proxy addresses are known.
# Set true only when every direct proxy address is listed below.
SALAMANDRA_TRUST_PROXY_HEADERS=false

# Comma-separated reverse-proxy IP addresses. Do not enter public client ranges.
SALAMANDRA_TRUSTED_PROXY_IPS=

# These local-only switches must remain disabled in staging and production.
SALAMANDRA_ENABLE_DEMO=false
SALAMANDRA_ALLOW_JSON_DEV=false
