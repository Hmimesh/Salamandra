# Private staging configuration template.
# Supply values through the deployment platform or secret manager. Do not commit
# a completed copy of this file.

# Runtime mode. Use staging for the private staging deployment.
SALAMANDRA_ENV=

# PostgreSQL SQLAlchemy URL. Store the completed value as a secret.
SALAMANDRA_DATABASE_URL=

# Canonical public HTTPS origin, including scheme and no path.
SALAMANDRA_APP_ORIGIN=

# Comma-separated exact HTTPS origins allowed to make credentialed requests.
SALAMANDRA_ALLOWED_ORIGINS=

# Comma-separated hostnames accepted in the HTTP Host header.
SALAMANDRA_TRUSTED_HOSTS=

# Require Secure authentication cookies in staging and production.
SALAMANDRA_COOKIE_SECURE=

# Session lifetime in seconds, between 300 and 604800.
SALAMANDRA_SESSION_MAX_AGE_SECONDS=

# Structured application log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
SALAMANDRA_LOG_LEVEL=

# Enable only when the app receives traffic exclusively from listed proxy IPs.
SALAMANDRA_TRUST_PROXY_HEADERS=

# Comma-separated reverse-proxy IP addresses. Do not enter public client ranges.
SALAMANDRA_TRUSTED_PROXY_IPS=

# These local-only switches must remain disabled in staging and production.
SALAMANDRA_ENABLE_DEMO=
SALAMANDRA_ALLOW_JSON_DEV=
